{
  "manifest_version": 3,
  "name": "Instagram Photo Audio Enabler",
  "version": "1.3.0",
  "description": "Plays the music attached to Instagram photo and carousel posts, which the web client downloads but never exposes.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "instagram-photo-audio@musicpost",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "js": [
        "src/page/payload.js",
        "src/page/scanner.js",
        "src/page/media-info.js",
        "src/page/interceptor.js"
      ]
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/content/state.js",
        "src/content/preferences.js",
        "src/content/dom.js",
        "src/content/player.js",
        "src/content/playback.js",
        "src/content/discovery.js",
        "src/content/main.js"
      ]
    }
  ]
}
